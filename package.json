{
  "name": "citycom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "test:browser": "playwright test",
    "check:architecture": "node scripts/check-fsd.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run check:architecture && npm run check:docs && npm run typecheck",
    "probe:sources": "node --import tsx scripts/probe-sources.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@google/genai": "2.32.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "papaparse": "5.7.0",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
