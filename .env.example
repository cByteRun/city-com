# Server-only; never use NEXT_PUBLIC for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Allow transfer of anonymized public text to the configured AI provider after review.
AI_TRANSFER_APPROVED=false
# LIVE login passwords (at least 12 characters each). No built-in LIVE passwords.
CITYCOM_ADMIN_PASSWORD=
CITYCOM_ANALYST_PASSWORD=
CITYCOM_DEPARTMENT_PASSWORD=
CITYCOM_VIEWER_PASSWORD=
CITYCOM_DEPARTMENT=ЖКХ
CITYCOM_SESSION_SECRET=
CITYCOM_DB_PATH=./data/citycom.sqlite
# Configure up to three authorized JSON, RSS or HTML JSON-LD endpoints. JSON: array of
# {id,text,url,publishedAt,authorId}; RSS: public resident submissions only.
CITYCOM_SOURCE_1_URL=
CITYCOM_SOURCE_1_NAME=Городской портал
CITYCOM_SOURCE_1_TYPE=JSON
CITYCOM_SOURCE_1_APPROVED=false
CITYCOM_SOURCE_2_URL=
CITYCOM_SOURCE_2_NAME=Публичные обсуждения
CITYCOM_SOURCE_2_TYPE=RSS
CITYCOM_SOURCE_2_APPROVED=false
CITYCOM_SOURCE_3_URL=
CITYCOM_SOURCE_3_NAME=Открытые обращения
CITYCOM_SOURCE_3_TYPE=JSON
CITYCOM_SOURCE_3_APPROVED=false

# Official Telegram bot, connected by its owner. No account passwords.
# Direct only accepts private text starting with the exact informed consent prefix in docs/SOURCE_RESEARCH.md.
CITYCOM_TELEGRAM_BOT_TOKEN=
CITYCOM_TELEGRAM_OWNER_APPROVED=false
# 32 random bytes as 64 hex characters; keep outside the database, back up securely.
CITYCOM_DIRECT_KEY=

# Official public social API adapters; source slot N uses CITYCOM_SOURCE_N_TOKEN.
# Never put tokens in UI URLs. Each slot uses its own authorized API token.
CITYCOM_SOURCE_1_TOKEN=
CITYCOM_SOURCE_2_TOKEN=
CITYCOM_SOURCE_3_TOKEN=
# Set supported versions from your VK/Meta application's official documentation.
CITYCOM_VK_API_VERSION=
CITYCOM_GRAPH_API_VERSION=
# Instagram uses Instagram Login (graph.instagram.com), Facebook uses graph.facebook.com.
# Telegram public channels: dedicated bot per source, added by channel owner;
# not the Direct bot. Only new opted-in channel posts are received; no history.
